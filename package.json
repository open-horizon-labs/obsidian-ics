{
  "name": "obsidian-ics",
  "version": "1.14.4-beta3",
  "description": "Adds events from calendar ics published on the web to daily note on demand. Daily Note or Periodic Notes plugins: specifically it gets the date to search for events during from the currently open daily note.",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "dev-build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs dev-build",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:dist-artifact": "jest --config jest.dist-artifact.config.js",
    "test:timezones": "node scripts/test-timezones.js",
    "update-timezones": "node scripts/update-timezones.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "moment-timezone": "^0.6.3",
    "node-ical": "^0.27.1",
    "obsidian-daily-notes-interface": "^0.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.18.0",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "^17.7.0",
    "jest": "^30.1.1",
    "obsidian": "^1.13.1",
    "ts-jest": "^29.4.1",
    "tslib": "2.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "overrides": {
    "@eslint/config-array": "^0.23.5",
    "eslint-plugin-json-schema-validator": "^6.3.0",
    "eslint-plugin-n": "^18.2.2",
    "glob": "^11.1.0"
  }
}
